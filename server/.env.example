# Server Port
PORT=5000

# Client Application URL for CORS
CLIENT_ORIGIN=http://localhost:5173

# Razorpay Test Mode Credentials
# Replace with your test key ID and key secret from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_dummy_key_id
RAZORPAY_KEY_SECRET=dummy_razorpay_secret_do_not_commit

# Optional Webhook Secret (for stretch goal)
RAZORPAY_WEBHOOK_SECRET=dummy_webhook_secret
